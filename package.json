{
  "name": "secret-space",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "setup": "node scripts/setup-local.mjs",
    "db:migrate:local": "wrangler d1 migrations apply secret-space --local",
    "db:migrate:remote": "wrangler d1 migrations apply secret-space --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260815.1",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
