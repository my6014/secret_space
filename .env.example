NODE_ENV=development
HOST=0.0.0.0
PORT=3000
COOKIE_SECURE=false

# sqlite (default) or mysql
DATABASE_DRIVER=sqlite
SQLITE_PATH=./data/secret-space.db
# MYSQL_URL=mysql://secret_space:change-me@127.0.0.1:3306/secret_space

USER_ONE_USERNAME=starlight
USER_ONE_NAME=星星
USER_ONE_PASSWORD_HASH="pbkdf2$210000$replace-me$replace-me"
USER_TWO_USERNAME=moonlight
USER_TWO_NAME=月亮
USER_TWO_PASSWORD_HASH="pbkdf2$210000$replace-me$replace-me"

SESSION_SECRET=replace-with-a-random-secret
CONTENT_ENCRYPTION_KEY=replace-with-a-random-32-byte-base64-key
